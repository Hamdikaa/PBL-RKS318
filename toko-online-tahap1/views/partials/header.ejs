<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | ' : '' %><%= toko.nama %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <link href="/css/produk.css" rel="stylesheet">
  <link href="/css/detail.css" rel="stylesheet">
  <link href="/css/belanja.css" rel="stylesheet">
  <link href="/css/profil.css" rel="stylesheet">
  <link href="/css/tema.css" rel="stylesheet">
  <link href="/css/motion.css" rel="stylesheet">
  <script>document.documentElement.classList.add("js")</script>
</head>
<body>
<% if (toko.pengumuman) { %><div class="pengumuman"><%= toko.pengumuman %></div><% } %>
<header class="kepala" id="kepala">
  <div class="kepala-isi">
    <button class="tombol-menu" id="tombolMenu" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="menuUtama"><span></span><span></span></button>
    <a class="logo" href="/"><%= toko.nama %></a>
    <nav class="menu-utama" id="menuUtama" aria-label="Menu utama">
      <a href="/produk">Koleksi</a>
      <a href="/produk?urut=rating">Rating tertinggi</a>
      <a href="/produk?urut=termurah">Harga terendah</a>
      <% if (user && (user.role === 'admin' || user.role === 'seller')) { %><a href="/admin">Dashboard</a><% } %>
      <div class="menu-akun"><%- include('akun') %></div>
    </nav>
    <div class="aksi">
      <div class="aksi-desktop"><%- include('akun') %></div>
      <% if (!user || user.role !== 'admin') { %>
        <a class="keranjang" href="/keranjang">Keranjang<% if (cartCount) { %> <span class="hitung"><%= cartCount %></span><% } %></a>
      <% } %>
    </div>
  </div>
</header>
<% if (flash) { %>
  <div class="container mt-3">
    <div class="alert alert-<%= flash.type %> mb-0" role="alert"><%= flash.text %></div>
  </div>
<% } %>
<main>
