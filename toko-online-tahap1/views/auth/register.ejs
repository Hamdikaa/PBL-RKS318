<%- include('../partials/header') %>
<section class="container auth">
  <div class="kartu-auth">
    <h1>Buat akun baru</h1>
    <p class="text-muted">Sudah punya akun? <a href="/login">Masuk</a></p>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <form method="post" action="/register" enctype="multipart/form-data">
      <label for="avatar" class="form-label">Foto profil (opsional)</label>
      <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp" class="form-control">
      <div class="form-text mb-3">JPG, PNG, atau WEBP, maksimal 2 MB.</div>

      <label for="nama" class="form-label">Nama lengkap</label>
      <input id="nama" name="nama" class="form-control mb-3" value="<%= form.nama || '' %>" autocomplete="name" required minlength="2">
      <label for="email" class="form-label">Email</label>
      <input id="email" name="email" type="email" class="form-control mb-3" value="<%= form.email || '' %>" autocomplete="email" required>
      <label for="alamat" class="form-label">Alamat</label>
      <textarea id="alamat" name="alamat" rows="3" class="form-control mb-3" autocomplete="street-address" required minlength="10" placeholder="Jalan, nomor, kelurahan, kota, kode pos"><%= form.alamat || '' %></textarea>
      <label for="password" class="form-label">Password</label>
      <input id="password" name="password" type="password" class="form-control mb-1" autocomplete="new-password" required minlength="6">
      <div class="form-text mb-3">Minimal 6 karakter.</div>
      <label for="konfirmasi" class="form-label">Ulangi password</label>
      <input id="konfirmasi" name="konfirmasi" type="password" class="form-control mb-4" autocomplete="new-password" required minlength="6">
      <button class="btn btn-mentari w-100">Buat akun</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
