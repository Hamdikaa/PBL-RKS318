<%- include('partials/header') %>
<section class="container belanja">
  <h1>Profil saya</h1>
  <div class="row g-4">
    <div class="col-md-6">
      <div class="kotak-bayar">
        <h2 class="h5 fw-bold">Data diri</h2>
        <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
        <div class="d-flex align-items-center gap-3 mb-3">
          <% if (u.avatar) { %><img class="avatar-besar" src="/uploads/<%= u.avatar %>" alt="Foto avatar">
          <% } else { %><span class="avatar-besar inisial" aria-hidden="true"><%= u.nama.charAt(0).toUpperCase() %></span><% } %>
          <div><strong><%= u.email %></strong><br><small class="text-muted">Peran: <%= u.role %></small></div>
        </div>
        <form method="post" action="/profil" enctype="multipart/form-data">
          <label for="nama" class="form-label">Nama</label>
          <input id="nama" name="nama" class="form-control mb-3" value="<%= u.nama %>" required minlength="2">
          <label for="telepon" class="form-label">No. HP</label>
          <input id="telepon" name="telepon" type="tel" class="form-control mb-3" value="<%= u.telepon || '' %>" placeholder="08xxxxxxxxxx">
          <label for="alamat" class="form-label">Alamat pengiriman</label>
          <textarea id="alamat" name="alamat" rows="3" class="form-control mb-3" placeholder="Jalan, nomor, kelurahan, kota, kode pos"><%= u.alamat || '' %></textarea>
          <label for="avatar" class="form-label">Foto avatar</label>
          <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp" class="form-control">
          <div class="form-text mb-3">JPG, PNG, atau WEBP, maksimal 2 MB.</div>
          <button class="btn btn-mentari">Simpan profil</button>
        </form>
        <% if (u.avatar) { %>
          <form method="post" action="/profil/avatar/hapus" class="mt-2"><button class="btn btn-sm btn-bahaya">Hapus foto avatar</button></form>
        <% } %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="kotak-bayar">
        <h2 class="h5 fw-bold">Ubah password</h2>
        <form method="post" action="/profil/password">
          <label for="lama" class="form-label">Password lama</label>
          <input id="lama" name="lama" type="password" class="form-control mb-3" autocomplete="current-password" required>
          <label for="baru" class="form-label">Password baru (minimal 6 karakter)</label>
          <input id="baru" name="baru" type="password" class="form-control mb-3" autocomplete="new-password" required minlength="6">
          <label for="konfirmasi" class="form-label">Ulangi password baru</label>
          <input id="konfirmasi" name="konfirmasi" type="password" class="form-control mb-3" autocomplete="new-password" required minlength="6">
          <button class="btn btn-garis">Ubah password</button>
        </form>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
