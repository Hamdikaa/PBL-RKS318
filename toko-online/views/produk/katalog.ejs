<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Banner Toko -->
<div class="bg-dark text-white py-5 mb-4 text-center" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://unsplash.com'); background-size: cover; background-position: center;">
    <div class="container py-3">
        <h1 class="fw-bold display-5">Selamat Datang di TokoKu</h1>
        <p class="text-light-50 opacity-75 fs-6 max-w-md mx-auto">Cari dan temukan barang impian dengan harga terbaik dan pelayanan ekstra cepat</p>
    </div>
</div>

<div class="container my-4 flex-grow-1">
    <!-- Kolom Pencarian -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-6">
            <form action="/produk" method="GET" class="input-group shadow-sm rounded-pill overflow-hidden bg-white border">
                <input type="text" name="search" class="form-control border-0 px-4 py-2.5" placeholder="Cari produk di sini..." value="<%= search %>">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>

    <!-- Grid Katalog Produk -->
    <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-grid-fill text-primary me-2"></i> Semua Produk</h4>
    
    <% if (products.length === 0) { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-emoji-frown text-muted fs-1"></i>
            <p class="text-muted mt-2 mb-0">Maaf, produk yang Anda cari tidak dapat ditemukan.</p>
        </div>
    <% } else { %>
        <div class="row row-cols-2 row-cols-md-4 g-3 g-md-4">
            <% products.forEach(prod => { %>
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                        <img src="/uploads/<%= prod.gambar || 'default.jpg' %>" class="card-img-top object-fit-cover" style="height: 180px;" alt="<%= prod.nama %>">
                        <div class="card-body d-flex flex-column p-3">
                            <span class="badge bg-light text-secondary text-capitalize align-self-start mb-2 small px-2.5 py-1 border border-light"><%= prod.kategori || 'Umum' %></span>
                            <h6 class="card-title fw-bold text-dark text-truncate mb-1"><%= prod.nama %></h6>
                            <p class="text-danger fw-bold fs-6 mb-2">Rp <%= prod.harga.toLocaleString('id-ID') %></p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-light">
                                <small class="text-muted">Stok: <b class="<%= prod.stok === 0 ? 'text-danger' : 'text-success' %>"><%= prod.stok %></b></small>
                                <a href="/produk/detail/<%= prod.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">Detail</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
