<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container my-5 flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-speedometer2 text-primary me-2"></i> Dashboard Admin</h4>
        <span class="badge bg-dark rounded-pill px-3 py-2 small">Mode Administrator</span>
    </div>

    <!-- Baris Menu Navigasi Khusus Internal Admin -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3"><a href="/admin/dashboard" class="btn btn-primary w-100 btn-sm fw-medium active">Ringkasan</a></div>
        <div class="col-6 col-md-3"><a href="/admin/produk" class="btn btn-outline-secondary w-100 btn-sm fw-medium">Kelola Produk</a></div>
        <div class="col-6 col-md-3"><a href="/admin/pesanan" class="btn btn-outline-secondary w-100 btn-sm fw-medium">Approval Bayar</a></div>
        <div class="col-6 col-md-3"><a href="/admin/user" class="btn btn-outline-secondary w-100 btn-sm fw-medium">Kelola User</a></div>
    </div>

    <!-- Kotak Indikator Metrik (Cards) -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card card-body border-0 shadow-sm bg-white p-4 text-center rounded-3">
                <i class="bi bi-wallet2 text-success fs-1 mb-2"></i>
                <h6 class="text-muted small fw-semibold uppercase mb-1">Total Omzet Lunas</h6>
                <h3 class="fw-bold text-dark mb-0">Rp <%= totalOmzet.toLocaleString('id-ID') %></h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body border-0 shadow-sm bg-white p-4 text-center rounded-3">
                <i class="bi bi-bell-fill text-warning fs-1 mb-2"></i>
                <h6 class="text-muted small fw-semibold uppercase mb-1">Butuh Verifikasi</h6>
                <h3 class="fw-bold text-dark mb-0"><%= pendingOrders %> <span class="fs-6 fw-normal text-muted">Pesanan</span></h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body border-0 shadow-sm bg-white p-4 text-center rounded-3">
                <i class="bi bi-box-seam-fill text-info fs-1 mb-2"></i>
                <h6 class="text-muted small fw-semibold uppercase mb-1">Jumlah Varian Produk</h6>
                <h3 class="fw-bold text-dark mb-0"><%= totalProducts %> <span class="fs-6 fw-normal text-muted">Item</span></h3>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>