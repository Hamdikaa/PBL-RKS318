<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container my-5 flex-grow-1">
    <h3 class="fw-bold mb-4 text-dark"><i class="bi bi-cart3 text-primary me-2"></i> Keranjang Belanja</h3>

    <% if (cart.length === 0) { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-cart-x text-muted" style="font-size: 3.5rem;"></i>
            <p class="text-muted mt-3 mb-4">Keranjang belanja Anda saat ini masih kosong.</p>
            <a href="/produk" class="btn btn-primary rounded-pill px-4 btn-sm fw-medium">Mulai Jelajah Produk</a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <!-- Sisi Kiri: Daftar List Belanjaan -->
            <div class="col-lg-8">
                <% cart.forEach(item => { %>
                    <div class="card card-body shadow-sm border-0 rounded-3 mb-3 p-3 bg-white">
                        <div class="row align-items-center g-3">
                            <!-- Foto Mikro -->
                            <div class="col-4 col-sm-2 text-center">
                                <img src="/uploads/<%= item.gambar || 'default.jpg' %>" class="img-fluid rounded border object-fit-cover" style="max-height: 80px;" alt="<%= item.nama %>">
                            </div>
                            <!-- Keterangan Barang -->
                            <div class="col-8 col-sm-4">
                                <h6 class="fw-bold text-dark text-truncate mb-1"><%= item.nama %></h6>
                                <p class="text-primary small fw-semibold mb-0">Rp <%= item.harga.toLocaleString('id-ID') %></p>
                            </div>
                            <!-- Form Atur Qty Lembut -->
                            <div class="col-7 col-sm-4">
                                <form action="/keranjang/update/<%= item.product_id %>" method="POST" class="d-flex align-items-center">
                                    <input type="number" name="qty" value="<%= item.qty %>" min="1" class="form-control form-control-sm text-center bg-light border-light" style="width: 70px;" onchange="this.form.submit()">
                                    <span class="text-muted small ms-2">Pcs</span>
                                </form>
                            </div>
                            <!-- Tombol Buang -->
                            <div class="col-5 col-sm-2 text-end">
                                <a href="/keranjang/delete/<%= item.product_id %>" class="btn btn-sm btn-outline-danger border-0 rounded-circle"><i class="bi bi-trash3-fill"></i></a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Sisi Kanan: Kotak Total Ringkasan Pembayaran -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 rounded-3 bg-white sticky-top" style="top: 90px; z-index: 10;">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Ringkasan Belanja</h5>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted small">Total Tagihan</span>
                        <span class="fw-bold text-danger fs-5">Rp <%= total.toLocaleString('id-ID') %></span>
                    </div>
                    <a href="/keranjang/checkout" class="btn btn-primary w-100 py-2.5 rounded-pill fw-bold shadow-sm">Lanjut Konfirmasi Checkout <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
