<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container my-5 flex-grow-1" style="max-width: 750px;">
    <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-clock-history text-success me-2"></i> Riwayat Belanja Saya</h4>

    <% if (orders.length === 0) { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-bag-x text-muted fs-1 d-block mb-3"></i>
            <p class="text-muted small mb-0">Anda belum pernah melakukan pemesanan barang apa pun.</p>
        </div>
    <% } else { %>
        <% orders.forEach(order => { %>
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-white">
                <!-- Kepala Nota -->
                <div class="card-header bg-white border-0 pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="text-secondary small fw-medium">Nota #<%= order.id %></span>
                        <span class="text-muted mx-1">|</span>
                        <span class="text-muted small"><%= order.tanggal %></span>
                    </div>
                    
                    <!-- Lencana Pewarnaan Status Dinamis -->
                    <% if (order.status === 'menunggu_bayar') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1.5 small"><i class="bi bi-credit-card-2-back-fill me-1"></i> Menunggu Bayar</span>
                    <% } else if (order.status === 'menunggu_verifikasi') { %>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1.5 small"><i class="bi bi-hourglass-split me-1"></i> Menunggu Verifikasi</span>
                    <% } else if (order.status === 'disetujui') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 small"><i class="bi bi-check-circle-fill me-1"></i> Lunas / Selesai</span>
                    <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 small"><i class="bi bi-x-circle-fill me-1"></i> Ditolak</span>
                    <% } %>
                </div>
                
                <!-- Badan Konten Item Transaksi -->
                <div class="card-body py-2 px-3 border-top border-light">
                    <% order.items.forEach(item => { %>
                        <div class="d-flex align-items-center py-2 border-bottom border-light-subtle last-border-0">
                            <img src="/uploads/<%= item.gambar || 'default.jpg' %>" style="width: 50px; height: 50px; object-fit: cover;" class="rounded border me-3 flex-shrink-0" alt="<%= item.nama %>">
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="mb-0 fw-semibold text-dark text-truncate small"><%= item.nama %></h6>
                                <small class="text-muted"><%= item.qty %> unit x Rp <%= item.harga.toLocaleString('id-ID') %></small>
                            </div>
                        </div>
                    <% }) %>
                    
                    <!-- Kaki Baris Nota Info Total Biaya -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 mb-2">
                        <div>
                            <span class="text-muted small d-block">Jumlah Tagihan</span>
                            <span class="fw-bold text-danger fs-6">Rp <%= order.total.toLocaleString('id-ID') %></span>
                        </div>

                        <!-- Tombol Kondisi Tergantung Status Transaksi -->
                        <% if (order.status === 'menunggu_bayar') { %>
                            <button class="btn btn-sm btn-primary rounded-pill px-3.5 fw-medium" data-bs-toggle="collapse" data-bs-target="#boxUpload<%= order.id %>">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Bayar Sekarang
                            </button>
                        <% } else if (order.bukti_bayar) { %>
                            <a href="/uploads/<%= order.bukti_bayar %>" target="_blank" class="btn btn-sm btn-light border rounded-pill px-3 text-secondary small">
                                <i class="bi bi-file-earmark-image me-1"></i> Pratinjau Bukti
                            </a>
                        <% } %>
                    </div>

                    <!-- Laci Collapse Upload Bukti Pembayaran -->
                    <div class="collapse mt-3" id="boxUpload<%= order.id %>">
                        <div class="card card-body bg-light border-0 rounded-3 p-3">
                            <form action="/order/upload-bukti/<%= order.id %>" method="POST" enctype="multipart/form-data">
                                <label class="form-label text-secondary small fw-semibold">Unggah Foto Struk / Tangkapan Layar Transfer Bank</label>
                                <div class="input-group input-group-sm">
                                    <input type="file" name="bukti_bayar" accept="image/*" required class="form-control border-light-subtle bg-white">
                                    <button type="submit" class="btn btn-primary px-3 fw-medium">Kirim Bukti</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<%- include('partials/footer') %>
